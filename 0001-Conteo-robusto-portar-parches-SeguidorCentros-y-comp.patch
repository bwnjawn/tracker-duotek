+    assert con.total == 1 and con.eventos[0].id == 1
+    sin = ContadorCanales([Canal("a", "A", [(0, 0), (1, 0), (1, 1), (0, 1)])], compensar_confirmacion=0)
+    mover(sin, 1, 0.5, ys)
+    assert sin.total == 0
