From c35ee66d8dfc3203d87fb8d9f2703efd937bfbea Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 22 Nov 2026 15:23:25 -0300
Subject: [PATCH] Conteo: min_hits=2 por defecto (con seq_0004 min_hits=3
 pierde un pez)

Detector real, error de conteo: seq_0003 y su video 0 % con min_hits 1-3;
seq_0004 (9 peces) 0 % con min_hits 1-2 y -11 % con min_hits=3 (un pez visto pocos cuadros).
Con etiquetas, min_hits=3 evita el sobreconteo de seq_0003 (+10 % con 1-2), pero en uso real
el detector es el que alimenta al seguidor. min_hits=2 es el punto medio.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01KaqjLSAQuh77qfNPFzhqoW
---
 src/contar_video.py | 6 +++---
 src/servicio.py     | 2 +-
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/contar_video.py b/src/contar_video.py
index 71272cf..b76f6fe 100644
--- a/src/contar_video.py
+++ b/src/contar_video.py
@@ -50,7 +50,7 @@ def ejecutar(
     video: str,
     canales: list[Canal],
     salida: str | Path,
-    min_hits: int = 3,
+    min_hits: int = 2,
     anotar: bool = True,
     max_cuadros: int | None = None,
     modelo: str = "",
@@ -103,8 +103,8 @@ def main() -> None:
     p.add_argument("--salida", required=True)
     p.add_argument("--conf", type=float, default=0.25)
     p.add_argument("--imgsz", type=int, default=640)
-    p.add_argument("--min-hits", type=int, default=3,
-                   help="cuadros mínimos en que debe verse un pez antes de contarlo (3 descarta falsos positivos sueltos)")
+    p.add_argument("--min-hits", type=int, default=2,
+                   help="cuadros mínimos en que debe verse un pez antes de contarlo (2 por defecto; 3 descarta más falsos positivos pero pierde peces vistos pocos cuadros)")
     p.add_argument("--compensar", type=int, default=1,
                    help="cuadros que se compensa el retraso de confirmación de ByteTrack (0 = no)")
     p.add_argument("--tracker", default="centros",
diff --git a/src/servicio.py b/src/servicio.py
index f5a7fc6..010cff4 100644
--- a/src/servicio.py
+++ b/src/servicio.py
@@ -75,7 +75,7 @@ class ServicioConteo:
         self,
         video: str,
         canales: list[Canal],
-        min_hits: int = 3,
+        min_hits: int = 2,
         progreso: Callable[[int, int], None] | None = None,
         por_cuadro: Callable | None = None,
         max_cuadros: int | None = None,
