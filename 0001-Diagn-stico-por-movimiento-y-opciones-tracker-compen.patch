diff --git a/src/diagnostico_conteo.py b/src/diagnostico_conteo.py
index 3fd3227..de65d00 100644
--- a/src/diagnostico_conteo.py
+++ b/src/diagnostico_conteo.py
@@ -57,13 +57,17 @@ def diagnosticar(detecciones_por_cuadro: dict[int, list], canales: list[Canal],
         propias = {tid: pts for tid, pts in pistas.items()
